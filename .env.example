# Discord bot token (Discord Developer Portal → your app → Bot → Token)
RSS_BOT_TOKEN=

# Channel ID where new releases get posted (right-click channel → Copy Channel ID,
# Developer Mode must be on in Discord settings)
RSS_CHANNEL_ID=

# How often to check the feed(s), in seconds
CHECK_INTERVAL=120

# Optional: small logo shown in the embed footer
SITE_ICON_URL=

# Optional role ID to ping on each release. Leave blank to ping no one.
ROLE_UPDATE=

# Optional: if more than this many "new" items show up in one check for a feed,
# treat it as that feed having changed/reset rather than real releases (nothing
# gets posted, everything just gets marked as seen)
FLOOD_LIMIT=10

# NOTE: feeds themselves are NOT configured here. Once the bot is running,
# add feeds with the /rss-create slash command (see README).
